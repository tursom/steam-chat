# Install separately as /etc/steam-chat/deploy.env, owned by root, mode 0600.
# Replace with a cryptographically random secret of at least 32 characters.
DEPLOY_WEBHOOK_SECRET=REPLACE_ME
DEPLOY_BIND=127.0.0.1
DEPLOY_PORT=3001
DEPLOY_STATE_DIR=/opt/steam-chat/deploy-state
DEPLOY_SCRIPT=/opt/steam-chat/deploy/deploy.sh
DEPLOY_ROOT=/opt/steam-chat
