\"cf56653153ca2ab7c440343d3f64fe7747300736fc37ddb332f68a006ecfcb76\"\n    }\n  },\n  {\n    \"id\": \"access-control\",\n    \"name\": \"access-control\",\n    \"description\": \"访问控制术语库，包含与访问控制（计算机科学领域）相关的术语的中文翻译。\",\n    \"author\": \"Ziv\",\n    \"glossary\": \"access-control\",\n    \"langs\": [\n      \"zh-CN\"\n    ],\n    \"i18ns\": {\n      \"zh-CN\": {\n        \"name\": \"访问控制\",\n        \"description\": \"访问控制术语库，包含与访问控制（计算机科学领域）相关的术语的中文翻译。\"\n      },\n      \"en\": {\n        \"name\": \"Access Control\",\n        \"description\": \"Access Control glossary, containing Chinese translations of terms related to access control (in the field of computer science).\"\n      }\n    },\n    \"langsHash\": {\n      \"zh-CN\": \"4884da75bbe2087529611963af84c4b475052bba244aa876e6aa747cf5892eae\"\n    }\n  },\n  {\n    \"id\": \"hd2\",\n    \"name\": \"Helldivers 2\",\n    \"description\": \"Chinese translations for Helldivers 2 game terms\",\n    \"author\": \"TWSFFTS_07007\",\n    \"glossary\": \"hd2\",\n    \"langs\": [\n      \"zh-CN\"\n    ],\n    \"i18ns\": {\n      \"zh-CN\": {\n        \"name\": \"《绝地潜兵 2》\",\n        \"description\": \"包含游戏内大多数专有名词的翻译。\"\n      }\n    },\n    \"langsHash\": {\n      \"zh-CN\": \"e5fd9fbbb1c667cee3ce57d6cdb5d43e0f63e44dc032eca5b1f8b7529823b476\"\n    }\n  },\n  {\n    \"id\": \"bg3\",\n    \"name\": \"Baldur's Gate 3\",\n    \"description\": \"Terminology for Baldur's Gate 3, including attributes, classes, races, spells, locations, and characters.\",\n    \"author\": \"Au3C2\",\n    \"glossary\": \"bg3\",\n    \"langs\": [\n      \"zh-CN\",\n      \"zh-TW\"\n    ],\n    \"i18ns\": {\n      \"zh-CN\": {\n        \"name\": \"博德之门 3\",\n        \"description\": \"博德之门 3 术语库，涵盖属性、职业、种族、法术、地点和角色名称。\"\n      },\n      \"zh-TW\": {\n        \"name\": \"博德之門 3\",\n        \"description\": \"博德之門 3 術語庫，涵蓋屬性、職業、種族、法術、地點和角色名稱。\"\n      },\n      \"en\": {\n        \"name\": \"Baldur's Gate 3\",\n        \"description\": \"Terminology for Baldur's Gate 3, including attributes, classes, races, spells, locations, and characters.\"\n      }\n    },\n    \"matches\": [\n      \"https://bg3.wiki/*\"\n    ],\n    \"langsHash\": {\n      \"zh-CN\": \"08bdc87be41afc934de4766ba491beb67b58bf9fc4a48fe79f95729b5cd06000\",\n      \"zh-TW\": \"0615052cd10f3780f539914e71ee9c3f8d2286ab8642d55c6e618c53863d3ea5\"\n    }\n  },\n  {\n    \"id\": \"biology\",\n    \"name\": \"Biology Expert\",\n    \"description\": \"Focuses on biological taxonomy ranks (Kingdom, Phylum, Class, Order, etc.) and core biological terms.\",\n    \"author\": \"mmlet\",\n    \"glossary\": \"biology\",\n    \"langs\": [\n      \"zh-CN\"\n    ],\n    \"matches\": [\n      \"*://*.wikipedia.org/*\",\n      \"*://*.wikidata.org/*\",\n      \"*://*.ncbi.nlm.nih.gov/*\",\n      \"*://*.nature.com/*\",\n      \"*://*.science.org/*\",\n      \"*://*.cell.com/*\",\n      \"*://*.gbif.org/*\",\n      \"*://*.biodiversitylibrary.org/*\",\n      \"*://*.iucnredlist.org/*\"\n    ],\n    \"i18ns\": {\n      \"zh-CN\": {\n        \"name\": \"生物学\",\n        \"description\": \"提供权威的生物分类学层级（界门纲目科属种）及常用生物学术语的英汉对照，纠正机器翻译的日常词汇混淆,且限制在特定网页,不误伤。\"\n      }\n    },\n    \"langsHash\": {\n      \"zh-CN\": \"e5971fb939ccc25ef45d87c8624c66145c299c546597d554e3a1c549800ba76c\"\n    }\n  },\n  {\n    \"id\": \"tennis\",\n    \"name\": \"Tennis Expert\",\n    \"description\": \"Specialized in translating tennis-related content, including rules, strokes, scoring, and tournament terminology.\",\n    \"author\": \"Tabris-ZX\",\n    \"glossary\": \"tennis\",\n    \"matches\": [\n      \"*://www.atptour.com/*\",\n      \"*://www.wtatennis.com/*\",\n      \"*://www.itftennis.com/*\",\n      \"*://www.usopen.org/*\",\n      \"*://www.wimbledon.com/*\",\n      \"*://www.rolandgarros.com/*\",\n      \"*://ausopen.com/*\",\n      \"*://www.daviscup.com/*\",\n      \"*://www.espn.com/tennis/*\",\n      \"*://www.eurosport.com/tennis/*\",\n      \"*://www.bbc.com/sport/tennis/*\",\n      \"*://sports.sina.com.cn/tennis/*\"\n    ],\n    \"langs\": [\n      \"zh-CN\",\n      \"zh-TW\"\n    ],\n    \"i18ns\": {\n      \"zh-CN\": {\n        \"name\": \"网球\",\n        \"description\": \"网球术语库，包含规则、击球、计分和赛事相关术语的中文翻译。\"\n      },\n      \"zh-TW\": {\n        \"name\": \"網球\",\n        \"description\": \"網球術語庫，包含規則、擊球、計分和賽事相關術語的繁體中文翻譯。\"\n      },\n      \"en\": {\n        \"name\": \"Tennis Expert\",\n        \"description\": \"Specialized in translating tennis-related content, including rules, strokes, scoring, and tournament terminology.\"\n      }\n    },\n    \"langsHash\": {\n      \"zh-CN\": \"3fc039d7f64234cb3d4fde788166c08e68e450b00829a1ab348038ec5284ac73\",\n      \"zh-TW\": \"7183749860e0fed8c3807131da403bd9fe670d599108ca9560d6a667605400ff\"\n    }\n  },\n  {\n    \"id\": \"programming-contest\",\n    \"name\": \"Programming Contest\",\n    \"description\": \"Specialized terminology for programming contest translation, covering contest formats, participant roles, problem statements, judging and verdicts, standings and scoring, and community jargon.\",\n    \"author\": \"Tabris-ZX\",\n    \"glossary\": \"programming-contest\",\n    \"matches\": [\n      \"*://codeforces.com/*\",\n      \"*://*.codeforces.com/*\",\n      \"*://atcoder.jp/*\",\n      \"*://*.atcoder.jp/*\",\n      \"*://vjudge.net/*\",\n      \"*://qoj.ac/*\",\n      \"*://www.codechef.com/*\",\n      \"*://onlinejudge.org/*\",\n      \"*://poj.org/*\",\n      \"*://www.poj.org/*\",\n      \"*://cp-algorithms.com/*\",\n      \"*://icpc.global/*\"\n    ],\n    \"langs\": [\n      \"zh-CN\",\n      \"zh-TW\"\n    ],\n    \"i18ns\": {\n      \"zh-CN\": {\n        \"name\": \"程序设计竞赛\",\n        \"description\": \"算法竞赛翻译专精术语库，涵盖赛事与参赛形式、人员角色、题面表达、评测流程与判定、榜单计分及社区俗语。\"\n      },\n      \"zh-TW\": {\n        \"name\": \"程式設計競賽\",\n        \"description\": \"程式設計競賽翻譯專用術語庫，涵蓋賽事與參賽形式、人員角色、題面用語、評測流程與判定、榜單計分及社群慣用語。\"\n      },\n      \"en\": {\n        \"name\": \"Programming Contest\",\n 