STEAM_CHAT_IMAGE=ghcr.io/tursom/steam-chat:latest
STEAM_CHAT_CONTAINER_NAME=steam-chat
STEAM_CHAT_BIND=0.0.0.0
STEAM_CHAT_PORT=3000
# Server WebSocket ping interval in ms (default 45000, 0 disables); keep below proxy idle timeouts.
STEAM_CHAT_WS_HEARTBEAT_MS=
# Optional host-side signed deployment receiver; keep empty to disable.
STEAM_CHAT_DEPLOY_WEBHOOK_URL=
